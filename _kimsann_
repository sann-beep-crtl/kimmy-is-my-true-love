<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Smartphone AU - Kimmy, Erine, Ribka</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        body {
            background-color: #1a1a1a;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .phone-container {
            width: 100%;
            max-width: 390px;
            height: 100%;
            max-height: 800px;
            background-color: #0f172a;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            position: relative;
            overflow: hidden;
        }
        @media (min-width: 391px) {
            .phone-container {
                border-radius: 40px;
                height: 85vh;
                border: 12px solid #333;
            }
        }
        
        /* Status Bar */
        .status-bar {
            height: 30px;
            background: rgba(0,0,0,0.2);
            color: white;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            font-size: 12px;
            z-index: 100;
        }

        /* Lockscreen */
        #lockscreen {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #1e1b4b, #312e81, #4c1d95);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            align-items: center;
            z-index: 50;
            padding: 40px 20px;
            text-align: center;
        }
        .lock-time {
            font-size: 54px;
            font-weight: 300;
            margin-top: 20px;
        }
        .lock-date {
            font-size: 16px;
            opacity: 0.8;
        }
        .pin-section {
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .pin-dots {
            display: flex;
            gap: 15px;
            margin-bottom: 25px;
        }
        .dot {
            width: 14px;
            height: 14px;
            border: 2px solid white;
            border-radius: 50%;
            background: transparent;
            transition: 0.2s;
        }
        .dot.active {
            background: white;
        }
        .keypad {
            display: grid;
            grid-template-columns: repeat(3, 65px);
            gap: 12px;
        }
        .key {
            width: 65px;
            height: 65px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            border: none;
            color: white;
            font-size: 20px;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            justify-content: center;
            align-items: center;
            backdrop-filter: blur(5px);
            transition: 0.2s;
        }
        .key:active {
            background: rgba(255, 255, 255, 0.3);
        }
        .error-msg {
            color: #fca5a5;
            font-size: 13px;
            height: 20px;
            margin-top: 10px;
        }

